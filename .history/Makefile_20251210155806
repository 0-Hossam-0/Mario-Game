# Compiler and flags
CXX = g++
CXXFLAGS = -I./include
# CHANGED: Windows libraries (opengl32, glu32, freeglut) instead of Linux ones
LDFLAGS = -lopengl32 -lglu32 -lfreeglut

# Directories
SRC_DIR = src
INCLUDE_DIR = include

# Target executable
# CHANGED: Added .exe so Windows knows exactly what to run/delete
TARGET = game.exe

# Source files
SOURCES = $(SRC_DIR)/main.cpp $(SRC_DIR)/Player.cpp $(SRC_DIR)/Mario.cpp $(SRC_DIR)/Luigi.cpp $(SRC_DIR)/Map.cpp $(SRC_DIR)/Platform.cpp $(SRC_DIR)/HUD.cpp $(SRC_DIR)/Menu.cpp

# Default target
all: $(TARGET)

# Build the executable
$(TARGET): $(SOURCES)
	$(CXX) -o $(TARGET) $(CXXFLAGS) $(SOURCES) $(LDFLAGS)

# Run the application
run: $(TARGET)
	./$(TARGET)

# Clean build artifacts
clean:
# CHANGED: explicit deletion for Windows
	del $(TARGET)

# Rebuild everything
rebuild: clean all

.PHONY: all run clean rebuild